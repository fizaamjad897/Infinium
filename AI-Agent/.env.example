# Infinium AI Backend - Environment Variables
# Copy this to .env and fill in your values

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=minimax-m2.7:cloud
CODE_REASONING_MODEL=kimi-k2.5:cloud
EMBED_MODEL=mxbai-embed-large

# ── Dual-Model Pipeline ──
USE_DUAL_MODEL=true

# ── GitHub OAuth (create an OAuth app at github.com/settings/developers) ──
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── JWT Security ──
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRE_HOURS=24

# ── GitHub Webhook (optional, for incremental sync) ──
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── GitHub API token (optional, lifts rate limit 60/hr → 5000/hr) ──
GITHUB_API_TOKEN=

# ── Slack integration (optional) ──
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ── Server ──
API_PORT=8000
